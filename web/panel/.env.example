# MPanel web 构建期环境变量（Vite）。复制为 web/.env 或 web/.env.local 后填写。
# 注意：VITE_* 会被编译进静态产物，任何 token 都会暴露给浏览器；生产环境更推荐
# 在部署目录放 config.json（不可放 token），token 由用户在 UI 中输入。

# ---------------------------------------------------------------------------
# 默认后端（编译期种子）
# ---------------------------------------------------------------------------
# 单个默认后端 URL（服务根地址，不要带 /api/v1）
# VITE_DEFAULT_BACKEND=https://panel.example.com
# 显示名（旧变量 VITE_DEFAULT_BACKEND_LABEL 仍兼容）
# VITE_DEFAULT_BACKEND_NAME=生产环境
# worker 或 core，默认 worker
# VITE_DEFAULT_BACKEND_KIND=core
# 仅 worker 需要；会被编译进 bundle，仅适合内网/测试
# VITE_DEFAULT_BACKEND_TOKEN=

# JSON 数组形式（优先于上面单个默认后端），支持一次预置多个连接：
# VITE_DEFAULT_BACKENDS=[{"id":"prod-core","name":"生产 core","kind":"core","baseUrl":"https://panel.example.com"},{"id":"dev-worker","name":"本地 worker","kind":"worker","baseUrl":"http://127.0.0.1:8787","token":"..."}]

# ---------------------------------------------------------------------------
# 其他
# ---------------------------------------------------------------------------
# dbx iframe 地址；可被运行时 config.json 的 dbxUrl 覆盖
# VITE_DBX_URL=http://localhost:3000
# 普通 API 超时（毫秒），默认 120000；图片 pull 等长任务单独使用 620000
# VITE_API_TIMEOUT_MS=120000
# 静态资源基路径，默认 /
# VITE_BASE_PATH=/

# ---------------------------------------------------------------------------
# 运行时 config.json（推荐，不放 token）
# ---------------------------------------------------------------------------
# 部署时在 web/dist/config.json 提供：
# {
#   "appName": "MPanel",
#   "dbxUrl": "https://dbx.example.com",
#   "allowUserConnections": true,
#   "backends": [
#     { "id": "prod-core", "name": "生产 core", "kind": "core", "baseUrl": "https://panel.example.com" }
#   ]
# }
# config.json 与编译期默认按 id 合并：同 id 覆盖，其余追加；config.json 优先。
