# MPanel 面板构建期环境变量（Vite）。
# 复制为 web/panel/.env.local 后填写。VITE_* 会被编译进静态产物，禁止写入真实凭据；
# 推荐在部署目录放 config.json（公开文件，也不能放 token），登录凭据由用户在 UI 中输入。

# ---------------------------------------------------------------------------
# 默认 core（编译期种子；面板只连接 core，不接受 agent 直连）
# ---------------------------------------------------------------------------
# 单个默认 core URL（服务根地址，不要带 /api/v1）
# VITE_DEFAULT_BACKEND=https://panel.example.com
# 显示名
# VITE_DEFAULT_BACKEND_NAME=生产 core
# 旧版本变量，worker 值会被忽略
# VITE_DEFAULT_BACKEND_KIND=core
# 可选：core Bearer token（仅限无 cookie 的脚本式访问；会进入 bundle，谨慎使用）
# VITE_DEFAULT_BACKEND_TOKEN=

# JSON 数组形式（优先于单个默认 core），支持一次预置多个 core 连接：
# VITE_DEFAULT_BACKENDS=[{"id":"prod-core","name":"生产 core","baseUrl":"https://panel.example.com"},{"id":"dev-core","name":"本地 core","baseUrl":"http://127.0.0.1:10086"}]

# ---------------------------------------------------------------------------
# 其他
# ---------------------------------------------------------------------------
# dbx iframe 地址；可被运行时 config.json 的 dbxUrl 覆盖
# VITE_DBX_URL=http://localhost:3000
# 普通 API 超时（毫秒），默认 120000；镜像 pull 等长任务单独使用 620000
# VITE_API_TIMEOUT_MS=120000
# 静态资源基路径，默认 /
# VITE_BASE_PATH=/

# ---------------------------------------------------------------------------
# 运行时 config.json（推荐，不放凭据）
# ---------------------------------------------------------------------------
# 部署时在 dist/config.json 提供：
# {
#   "appName": "MPanel",
#   "dbxUrl": "https://dbx.example.com",
#   "allowUserConnections": true,
#   "backends": [
#     { "id": "prod-core", "name": "生产 core", "baseUrl": "https://panel.example.com" }
#   ]
# }
# config.json 与编译期默认按 id 合并：同 id 覆盖，其余追加；config.json 优先。
# kind=worker 的旧条目会被忽略——web/panel 不直连 agent。
