# syntax=docker/dockerfile:1
#
# MPanel worker image (host agent: sites/Caddy, certs, databases, containers,
# files, terminal, tasks). Build from the repository root:
#   docker build -f deploy/Dockerfile.worker -t mpanel-worker:0.1.0 .
#
# NOTE: This Dockerfile has NOT been built or run in this repository's local
# environment (no Docker available). Treat it as a reviewed template, not a
# verified image.
#
# The image contains Node, a POSIX shell and the worker itself. It does NOT
# contain Caddy, the Docker CLI, psql/pg_dump or redis-cli; those capabilities
# report available=false until you extend the image or mount host tools.
# See docs/operations.md §9 for the container/host boundary.

# ---------------------------------------------------------------------------
# Build stage: install workspace deps (node-pty is a native optional module),
# build shared/worker, then `pnpm deploy` for dist + production node_modules.
# ---------------------------------------------------------------------------
FROM node:24-bookworm-slim AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable && corepack prepare pnpm@12.10.1 --activate

# Toolchain for node-pty when no prebuilt binary matches this platform/Node.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY .npmrc package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./
COPY server/shared/package.json server/shared/
COPY server/worker/package.json server/worker/
COPY server/core/package.json server/core/
COPY web/package.json web/

RUN pnpm install --frozen-lockfile

COPY server/shared/src server/shared/src
COPY server/shared/tsconfig.json server/shared/package.json server/shared/
COPY server/worker/src server/worker/src
COPY server/worker/tsconfig.json server/worker/package.json server/worker/

RUN pnpm --filter @mpanel/shared build \
 && pnpm --filter @mpanel/worker build

RUN pnpm --filter @mpanel/worker deploy --prod /out/worker

# ---------------------------------------------------------------------------
# Runtime stage: non-root, production dependencies only, health check.
# ---------------------------------------------------------------------------
FROM node:24-bookworm-slim AS runtime

ENV NODE_ENV=production \
    MPANEL_HOME=/var/lib/mpanel/worker \
    MPANEL_TRANSPORT=http \
    MPANEL_HOST=0.0.0.0 \
    MPANEL_PORT=8787 \
    MPANEL_LOG_LEVEL=info

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 10001 mpanel \
 && useradd --uid 10001 --gid mpanel --home-dir /var/lib/mpanel/worker --no-create-home --shell /usr/sbin/nologin mpanel \
 && mkdir -p /app /var/lib/mpanel/worker \
 && chown -R 10001:10001 /app /var/lib/mpanel

WORKDIR /app

COPY --from=build --chown=10001:10001 /out/worker/ ./

USER 10001:10001

EXPOSE 8787

# Only http transport listens on a deterministic port. In stdio/reverse-ws mode
# the worker opens a loopback random port, so the image health check treats
# those modes as healthy; rely on core machine status for real availability.
# /healthz is unauthenticated.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "if((process.env.MPANEL_TRANSPORT||'http')!=='http'){process.exit(0)}const p=(process.env.MPANEL_LISTEN||'').match(/:(\d+)$/)?.[1]||process.env.MPANEL_PORT||'8787';fetch('http://127.0.0.1:'+p+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

STOPSIGNAL SIGTERM

CMD ["node", "dist/index.js", "serve"]
