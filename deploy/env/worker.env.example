# MPanel worker environment (docs/file-layout.md §4.1, server/worker/src/config.ts).
# Copy to /etc/mpanel/worker.env, chmod 600, and fill in real values.
# Do NOT load this file into core: MPANEL_HOME/MPANEL_PORT/MPANEL_LISTEN collide.

# --- shared state ----------------------------------------------------------
MPANEL_HOME=/var/lib/mpanel/worker
MPANEL_LOG_LEVEL=info
# 32-byte key; prefer the auto-created $MPANEL_HOME/secrets.key (0600).
# MPANEL_SECRET_KEY=
# MPANEL_SECRET_KEY_FILE=/var/lib/mpanel/worker/secrets.key

# --- transport: http | stdio | reverse-ws ----------------------------------
MPANEL_TRANSPORT=http
MPANEL_HOST=127.0.0.1
MPANEL_PORT=8787
# Required for `serve`; generate with:
#   node /opt/mpanel/worker/dist/index.js token generate --length 32
MPANEL_TOKEN=
# Compatibility/reserved: current handoff redeem uses a relative URL and does not
# join this value. Safe to set to the public panel URL for future use.
MPANEL_PUBLIC_URL=https://panel.example.com
MPANEL_CORS_ORIGINS=https://panel.example.com
# MPANEL_DBX_ORIGIN=https://dbx.example.com

# --- reverse-ws enrollment (issued once by core) --------------------------
# MPANEL_CORE_URL=wss://panel.example.com/ws/worker
# MPANEL_MACHINE_ID=m_xxxxxxxx
# MPANEL_MACHINE_SECRET=mp_xxxxxxxx
MPANEL_CORE_INSECURE=false

# --- edge enrollment (shared key from core; no pre-created machine) --------
# MPANEL_TRANSPORT=reverse-ws
# MPANEL_CORE_URL=https://panel.example.com
# MPANEL_EDGE_KEY=mpedge_xxxxxxxx

# --- Caddy ----------------------------------------------------------------
MPANEL_CADDY_BIN=/usr/bin/caddy
MPANEL_CADDY_CONFIG_DIR=/etc/caddy
MPANEL_CADDY_DATA_DIR=/var/lib/caddy
# Preferred over `caddy reload` when Caddy runs as a service with an admin API.
# MPANEL_CADDY_ADMIN=127.0.0.1:2019
# Site root allowlist (absolute paths). Default also includes all file roots
# and $MPANEL_HOME/sites.
# MPANEL_SITES_ROOTS=/srv/www

# --- Docker ---------------------------------------------------------------
MPANEL_DOCKER_BIN=/usr/bin/docker
# MPANEL_DOCKER_COMPOSE_BIN=/usr/libexec/docker/cli-plugins/docker-compose

# --- Databases ------------------------------------------------------------
MPANEL_PG_DUMP_BIN=/usr/bin/pg_dump
MPANEL_PG_RESTORE_BIN=/usr/bin/pg_restore
MPANEL_PSQL_BIN=/usr/bin/psql
MPANEL_REDIS_CLI_BIN=/usr/bin/redis-cli
# MPANEL_DATABASE_BACKUP_DIR=/var/lib/mpanel/worker/backups/databases

# --- Files ----------------------------------------------------------------
# MPANEL_FILES_ROOTS=files=/srv/mpanel/files,www=/srv/www
MPANEL_MAX_UPLOAD_BYTES=104857600
# MPANEL_TRASH_DIR=/var/lib/mpanel/worker/trash

# --- Tasks ----------------------------------------------------------------
# MPANEL_TASK_SHELL=/bin/bash
MPANEL_TASK_HISTORY_LIMIT=1000
MPANEL_REDEEM_RATE_LIMIT=10/60s
