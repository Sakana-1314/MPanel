# MPanel core environment (docs/file-layout.md §4.2, server/core/src/config.ts).
# Copy to /etc/mpanel/core.env, chmod 600, and fill in real values.
# Do NOT load this file into a worker: MPANEL_HOME/MPANEL_PORT/MPANEL_LISTEN
# are shared names and would collide.

# --- state and listen ------------------------------------------------------
MPANEL_CORE_HOME=/var/lib/mpanel/core
# Behind a TLS reverse proxy, bind loopback only.
MPANEL_LISTEN=127.0.0.1:8790
# Public browser URL; also used to derive reverse-ws enrollment (wss://…/ws/worker).
MPANEL_PUBLIC_URL=https://panel.example.com

# --- web static hosting ----------------------------------------------------
MPANEL_WEB_DIST=/opt/mpanel/web

# --- auth / session --------------------------------------------------------
# First start only (users.json empty). Password >= 10 chars.
# Leave both empty to use the one-time bootstrap token printed at startup and
# written to $MPANEL_CORE_HOME/state/bootstrap-token (0600).
# MPANEL_ADMIN_USER=admin
# MPANEL_ADMIN_PASSWORD=

# HMAC key for sessions/API tokens. Empty -> generated in $MPANEL_CORE_HOME/session.secret.
# MPANEL_SESSION_SECRET=
MPANEL_COOKIE_NAME=mpanel_session
# true for HTTPS; if unset it auto-enables when PUBLIC_URL is https or SameSite=None.
# For local HTTP testing set it to false (Secure cookies are ignored over HTTP).
MPANEL_COOKIE_SECURE=true
MPANEL_COOKIE_SAMESITE=lax
MPANEL_TOKEN_TTL=12h
MPANEL_SESSION_TTL_HOURS=168

# Script-only static bearer (>=16 chars), maps to a system admin. Optional.
# MPANEL_CORE_TOKEN=

# --- CORS / proxy / dbx ----------------------------------------------------
# Only needed when the web UI is served from a different origin than core.
# MPANEL_CORS_ORIGINS=https://panel.example.com
# MPANEL_DBX_ORIGIN=https://dbx.example.com
# Set true when core is directly behind Caddy/nginx so rate limiting sees the
# real client IP and HTTPS is detected.
MPANEL_TRUST_PROXY=true

# --- machines / transports -------------------------------------------------
# stdio = execute a worker as a child of core on this host. Danger switch.
MPANEL_ALLOW_STDIO=0
# MPANEL_WORKER_ENTRY=/opt/mpanel/worker/dist/index.js
# AES-256-GCM key for machine credentials. Empty -> generate $MPANEL_CORE_HOME/secrets.key.
# MPANEL_SECRET_KEY=
# Allow reverse-ws ?machineId=&secret= auth. Keep false; use Authorization header.
MPANEL_ALLOW_WS_QUERY_SECRET=false
MPANEL_REDEEM_RATE_LIMIT=10/60s

# --- static CSP / logging --------------------------------------------------
# MPANEL_CSP=
MPANEL_LOG_LEVEL=info
# MPANEL_MACHINE_HEALTH_INTERVAL_MS=15000
# MPANEL_MACHINE_HEALTH_MAX_INTERVAL_MS=60000
# MPANEL_MACHINE_HEALTH_CONCURRENCY=4
