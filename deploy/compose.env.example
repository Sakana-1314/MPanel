# MPanel Docker Compose 环境变量示例。
#   cp deploy/compose.env.example deploy/compose.env
#   # 填入真实值；compose.env 不得提交到版本库
#   docker compose -f deploy/docker-compose.yml --env-file deploy/compose.env up -d --build
#
# 这些变量只用于 Compose 插值；容器内的实际环境变量在 docker-compose.yml 中映射。

# ---------------------------------------------------------------------------
# 公网地址与 core
# ---------------------------------------------------------------------------
# 浏览器访问面板的地址；HTTPS 反代时应为 https://panel.example.com
MPANEL_PUBLIC_URL=http://localhost:8790

# 只绑定回环时由宿主反代终止 TLS；确认后再改成 0.0.0.0
MPANEL_BIND_ADDRESS=127.0.0.1

# 首次启动 seed 管理员；两项都留空则使用一次性 bootstrap token。
# 只设置其中一项会让 core 以配置错误退出。
MPANEL_ADMIN_USER=
MPANEL_ADMIN_PASSWORD=

# 跨站前端才需要；core 自己托管 web 时留空
MPANEL_CORS_ORIGINS=
# dbx iframe 源（纯 origin，不带路径）
MPANEL_DBX_ORIGIN=

# 留空自动：HTTPS 或 SameSite=None 时为 true
MPANEL_COOKIE_SECURE=
MPANEL_COOKIE_SAMESITE=
# 反向代理后设为 true，限流才能看到真实客户端 IP
MPANEL_TRUST_PROXY=false

# 建议显式设置并单独备份；留空则在 core-data 卷内自动生成
MPANEL_SESSION_SECRET=
MPANEL_SECRET_KEY=

MPANEL_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# http worker
# ---------------------------------------------------------------------------
# 生成：node server/worker/dist/index.js token generate --length 32
# 在 core 的“机器”页添加 http 机器时：
#   地址 http://worker-http:8787（compose 网络内）
#   token 与本值一致
WORKER_HTTP_TOKEN=

# ---------------------------------------------------------------------------
# reverse-ws worker（仅 --profile reverse-ws）
# ---------------------------------------------------------------------------
# 在 core 中创建 reverse-ws 机器后，把响应里的 workerEnv 抄到这里。
# secret 只显示一次；遗失只能 rotate（旧连接会被断开）。
WORKER_REVERSE_MACHINE_ID=
WORKER_REVERSE_MACHINE_SECRET=
WORKER_REVERSE_TOKEN=
# 跨主机/经 TLS 反代时改成 wss://panel.example.com/ws/worker
WORKER_REVERSE_CORE_URL=ws://core:8790/ws/worker
MPANEL_CORE_INSECURE=false

# ---------------------------------------------------------------------------
# 边缘节点 worker（仅 --profile edge）
# ---------------------------------------------------------------------------
# 在 core 的「边缘节点」页新建入网密钥，把密钥填到这里即可；不需要预建机器。
# 身份会持久化在 worker-edge-data 卷的 edge.json 里，重启复用。
WORKER_EDGE_KEY=
# core 的 HTTP 基地址（compose 网络内用 http://core:8790；跨主机用 https://panel.example.com）
WORKER_EDGE_CORE_URL=http://core:8790
