# MPanel core gateway (auth + machine registry + HTTP/WS proxy + static web).
#
# Install:
#   sudo cp deploy/systemd/mpanel-core.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mpanel-core
#
# Assumptions (adjust to your layout):
#   - release output at /opt/mpanel/core (pnpm deploy: dist + production node_modules)
#   - state at /var/lib/mpanel/core, env at /etc/mpanel/core.env (0600)
#   - run as the unprivileged mpanel user
#
# NOTE: this unit has NOT been verified on a systemd host in this repository's
# local environment. Test in staging before production.
[Unit]
Description=MPanel core gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mpanel
Group=mpanel
WorkingDirectory=/opt/mpanel/core
EnvironmentFile=/etc/mpanel/core.env
ExecStart=/usr/bin/node dist/index.js serve
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077

# State directory. MPANEL_CORE_HOME in /etc/mpanel/core.env must match this
# path (or add your custom path to ReadWritePaths below).
StateDirectory=mpanel/core
StateDirectoryMode=0700
ReadWritePaths=/var/lib/mpanel/core

# --- hardening ------------------------------------------------------------
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# PrivateDevices is safe for core (no PTY/Docker); if Node fails to start on
# an unusual kernel, set this to false.
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Do NOT set MemoryDenyWriteExecute=yes: Node's JIT needs writable executable
# memory. Do NOT weaken ProtectSystem: core only needs its state directory.
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
