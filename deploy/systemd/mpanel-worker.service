# MPanel worker agent (sites/Caddy, certs, databases, containers, files,
# terminal, tasks).
#
# Install:
#   sudo cp deploy/systemd/mpanel-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mpanel-worker
#
# Assumptions (adjust to your layout):
#   - release output at /opt/mpanel/worker (pnpm deploy: dist + production node_modules)
#   - state at /var/lib/mpanel/worker, env at /etc/mpanel/worker.env (0600)
#   - Caddy config/data at /etc/caddy and /var/lib/caddy (optional)
#   - site/file roots under /srv/www (optional)
#
# NOTE: this unit has NOT been verified on a systemd host in this repository's
# local environment. Test in staging before production.
[Unit]
Description=MPanel worker agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mpanel
Group=mpanel
WorkingDirectory=/opt/mpanel/worker
EnvironmentFile=/etc/mpanel/worker.env
ExecStart=/usr/bin/node dist/index.js serve
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=mixed
UMask=0077

# State directory. MPANEL_HOME in /etc/mpanel/worker.env must match this path
# (or add your custom path to ReadWritePaths below).
StateDirectory=mpanel/worker
StateDirectoryMode=0700
# Caddy config/data and site roots are optional; the '-' prefix keeps the unit
# startable when a path does not exist. Add every writable root you configure
# in MPANEL_FILES_ROOTS / MPANEL_SITES_ROOTS / MPANEL_CADDY_* .
ReadWritePaths=/var/lib/mpanel/worker -/etc/caddy -/var/lib/caddy -/srv/www

# Docker access requires the mpanel user to be in the docker group. This is
# equivalent to host root; enable only if the panel manages Docker.
# SupplementaryGroups=docker

# --- hardening ------------------------------------------------------------
ProtectSystem=strict
# read-only (not true) so file/site roots under /home stay visible; add them
# to ReadWritePaths if they need to be writable.
ProtectHome=read-only
PrivateTmp=true
# Do NOT enable PrivateDevices: terminal PTY (/dev/ptmx) and Docker tooling
# need host devices.
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# Do NOT use ProtectProc=invisible: tasks/terminal are trusted-owner features
# and may legitimately inspect host processes.
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
# Tasks and terminal sessions execute arbitrary commands. A system-call filter
# can break those commands; enable only after testing your workloads:
# SystemCallFilter=@system-service
# SystemCallErrorNumber=EPERM
# Do NOT set MemoryDenyWriteExecute=yes: Node's JIT needs writable executable
# memory.
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
