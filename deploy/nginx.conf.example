# MPanel nginx reverse proxy example.
#
# Place at /etc/nginx/conf.d/mpanel.conf and adjust:
#   - server_name / certificate paths
#   - upstream port if you changed MPANEL_LISTEN (default example: 8790)
#
# This proxies everything to core, including:
#   /api/v1/*                       REST
#   /ws/worker                      reverse-ws worker enrollment
#   /api/v1/machines/:id/proxy/ws/* proxied WebSockets (terminal/logs)
#
# Core serves the CSP / nosniff / Referrer-Policy headers itself. Do not add a
# second, stricter Content-Security-Policy here: multiple CSP headers intersect
# and can break the dbx iframe.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream mpanel_core {
    server 127.0.0.1:8790;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name panel.example.com;

    return 301 https://$host$request_uri;
}

server {
    # nginx >= 1.25 prefers a separate `http2 on;` line; the combined form below
    # still works and is kept for compatibility with older packages.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name panel.example.com;

    ssl_certificate     /etc/letsencrypt/live/panel.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/panel.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # worker default upload limit is 100 MiB; core proxy body limit is 110 MiB.
    client_max_body_size 128m;

    location / {
        proxy_pass http://mpanel_core;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # WebSocket upgrade (terminal, container logs, reverse-ws /ws/worker)
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Long-running API calls: image pulls, backups, large uploads/downloads.
        proxy_read_timeout  620s;
        proxy_send_timeout  620s;
        proxy_connect_timeout 15s;

        # Stream uploads/downloads and WS frames instead of buffering them.
        proxy_request_buffering off;
        proxy_buffering         off;
    }

    # Set MPANEL_TRUST_PROXY=true on core so rate limiting and logs see the
    # real client IP from X-Forwarded-For.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
}

