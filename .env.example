# MPanel 环境变量参考模板
#
# 重要：
# 1. Node 不会自动读取 .env。用以下任一方式加载：
#      node --env-file=.env server/worker/dist/index.js serve
#      export $(grep -v '^#' .env | xargs)          # POSIX，慎用含空格的值
#      systemd EnvironmentFile= / Docker env_file
# 2. 本文件只配置 **worker**。core 请使用 deploy/env/core.env.example；
#    不要把 worker 与 core 的变量合并到一个文件：两边都读取 MPANEL_HOME /
#    MPANEL_PORT / MPANEL_LISTEN，core 会绑定 worker 的端口或状态目录。
# 3. 绝不要提交真实 token、密码、secret 或 .env 文件。
# 完整变量表见 README「环境变量」与 docs/file-layout.md §4。

# ---------------------------------------------------------------------------
# worker（server/worker）
# ---------------------------------------------------------------------------
# 状态根：state/、logs/、caddy/、files/、backups/、trash/、stacks/。
MPANEL_HOME=./mpanel-home

# http（默认）| stdio | reverse-ws
MPANEL_TRANSPORT=http
MPANEL_HOST=127.0.0.1
MPANEL_PORT=8787
# MPANEL_LISTEN=127.0.0.1:8787

# serve 必需。可留空：token generate --write 会把 token 写入
# $MPANEL_HOME/config.json，环境变量为空时自动读取该文件。
# 生成：node server/worker/dist/index.js token generate --length 32 --write
MPANEL_TOKEN=

# 浏览器跨域来源（逗号/空格分隔）。web dev 是 5173；生产只列面板真实域名。
MPANEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# MPANEL_DBX_ORIGIN=https://dbx.example.com
# 兼容/预留：当前 handoff redeem 固定相对路径，不与该值拼接
# MPANEL_PUBLIC_URL=https://panel.example.com

MPANEL_LOG_LEVEL=info

# --- reverse-ws 注册（由 core 创建/轮换机器时一次性下发） -------------------
# MPANEL_CORE_URL=wss://panel.example.com/ws/worker
# MPANEL_MACHINE_ID=m_xxxxxxxx
# MPANEL_MACHINE_SECRET=mp_xxxxxxxx
# 仅本地自签证书调试；生产保持 false
MPANEL_CORE_INSECURE=false

# --- 边缘节点自助入网（与上面的预建 reverse-ws 二选一） ---------------------
# 在 core 的「边缘节点」页生成入网密钥；地址填 HTTP(S) 基地址（不是 ws 路径）。
# MPANEL_TRANSPORT=reverse-ws
# MPANEL_CORE_URL=https://panel.example.com
# MPANEL_EDGE_KEY=mpedge_xxxxxxxx

# --- Caddy -----------------------------------------------------------------
MPANEL_CADDY_BIN=caddy
# MPANEL_CADDY_CONFIG_DIR=/etc/caddy
# MPANEL_CADDY_DATA_DIR=/var/lib/caddy
# MPANEL_CADDY_ADMIN=127.0.0.1:2019
# 站点根白名单；默认还会加入各文件根与 $MPANEL_HOME/sites
# MPANEL_SITES_ROOTS=/srv/www

# --- Docker ----------------------------------------------------------------
MPANEL_DOCKER_BIN=docker
# MPANEL_DOCKER_COMPOSE_BIN=/usr/libexec/docker/cli-plugins/docker-compose

# --- 数据库工具 -------------------------------------------------------------
MPANEL_PG_DUMP_BIN=pg_dump
MPANEL_PG_RESTORE_BIN=pg_restore
MPANEL_PSQL_BIN=psql
MPANEL_REDIS_CLI_BIN=redis-cli

# --- 文件 ------------------------------------------------------------------
# 格式 name=absolutePath[,name=absolutePath]；默认 files=$MPANEL_HOME/files
# MPANEL_FILES_ROOTS=files=/srv/mpanel/files,www=/srv/www
MPANEL_MAX_UPLOAD_BYTES=104857600
# MPANEL_TRASH_DIR=/var/lib/mpanel/worker/trash
# MPANEL_DATABASE_BACKUP_DIR=/var/lib/mpanel/worker/backups/databases

# --- 计划任务 ---------------------------------------------------------------
# MPANEL_TASK_SHELL=/bin/bash
MPANEL_TASK_HISTORY_LIMIT=1000

# --- 机密与限流 -------------------------------------------------------------
# 32 字节密钥（base64 或 64 位 hex）。留空则生成 $MPANEL_HOME/secrets.key（0600）。
# MPANEL_SECRET_KEY=
# MPANEL_SECRET_KEY_FILE=/var/lib/mpanel/worker/secrets.key
MPANEL_REDEEM_RATE_LIMIT=10/60s

# ---------------------------------------------------------------------------
# core（server/core）—— 仅作为参考清单，请复制到独立文件后使用
# deploy/env/core.env.example 是更完整的 core 模板。
# ---------------------------------------------------------------------------
# MPANEL_CORE_HOME=./mpanel-core
# MPANEL_LISTEN=127.0.0.1:8790
# MPANEL_PUBLIC_URL=https://panel.example.com
# MPANEL_WEB_DIST=web/dist
# MPANEL_ALLOW_STDIO=0
# MPANEL_WORKER_ENTRY=server/worker/dist/index.js
# MPANEL_CORS_ORIGINS=https://panel.example.com
# MPANEL_DBX_ORIGIN=https://dbx.example.com
# MPANEL_COOKIE_NAME=mpanel_session
# MPANEL_COOKIE_SECURE=false
# MPANEL_COOKIE_SAMESITE=lax
# MPANEL_TOKEN_TTL=12h
# 设置后覆盖会话 TTL（小时）；不设置时跟随 MPANEL_TOKEN_TTL，默认 12h
# MPANEL_SESSION_TTL_HOURS=168
# 仅脚本使用；至少 16 字符，映射为 system 管理员
# MPANEL_CORE_TOKEN=
# 首次启动 seed 管理员；密码至少 10 字符，users.json 存在后忽略
# MPANEL_ADMIN_USER=admin
# MPANEL_ADMIN_PASSWORD=
# MPANEL_TRUST_PROXY=false
# MPANEL_SECRET_KEY=
# MPANEL_SESSION_SECRET=
# MPANEL_ALLOW_WS_QUERY_SECRET=false
# MPANEL_REDEEM_RATE_LIMIT=10/60s
# MPANEL_CSP=
# MPANEL_LOG_LEVEL=info
# MPANEL_MACHINE_HEALTH_INTERVAL_MS=15000
# MPANEL_MACHINE_HEALTH_MAX_INTERVAL_MS=60000
# MPANEL_MACHINE_HEALTH_CONCURRENCY=4

# ---------------------------------------------------------------------------
# web 构建期（Vite，复制到 web/.env 或导出后构建）
# 注意：VITE_* 会被编译进静态产物；不要把生产 token 放进去。
# ---------------------------------------------------------------------------
# VITE_DEFAULT_BACKEND=https://panel.example.com
# VITE_DEFAULT_BACKEND_KIND=core
# VITE_DEFAULT_BACKEND_NAME=生产 core
# VITE_DEFAULT_BACKEND_TOKEN=
# VITE_DEFAULT_BACKENDS=[{"id":"prod-core","name":"生产 core","kind":"core","baseUrl":"https://panel.example.com"}]
# VITE_DBX_URL=https://dbx.example.com
# VITE_API_TIMEOUT_MS=120000
# VITE_BASE_PATH=/

# ---------------------------------------------------------------------------
# web 运行时 config.json（放在 web/dist/config.json；公开文件，不含凭据）
# ---------------------------------------------------------------------------
# {
#   "appName": "MPanel",
#   "dbxUrl": "https://dbx.example.com",
#   "allowUserConnections": true,
#   "backends": [
#     { "id": "prod-core", "name": "生产 core", "kind": "core", "baseUrl": "https://panel.example.com" }
#   ]
# }
