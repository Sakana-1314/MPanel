{
  "name": "mpanel",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "MPanel — self-hosted server control panel (core / worker / web monorepo)",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1",
  "workspaces": [
    "server/shared",
    "server/worker",
    "server/core",
    "web"
  ],
  "scripts": {
    "build:shared": "node node_modules/typescript/bin/tsc -b server/shared",
    "build": "node node_modules/typescript/bin/tsc -b && pnpm --filter @mpanel/web build",
    "typecheck": "node node_modules/typescript/bin/tsc -b && pnpm --filter @mpanel/web typecheck",
    "dev": "node node_modules/typescript/bin/tsc -b server/shared && pnpm --parallel --filter @mpanel/worker --filter @mpanel/core --filter @mpanel/web dev",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "start:worker": "node server/worker/dist/index.js",
    "start:core": "node server/core/dist/index.js",
    "deploy:worker": "pnpm --filter @mpanel/worker deploy --prod out/worker",
    "deploy:core": "pnpm --filter @mpanel/core deploy --prod out/core",
    "clean": "pnpm -r clean && node -e \"for (const p of ['server/shared','server/worker','server/core','web']) require('node:fs').rmSync(p + '/dist', {recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^24.19.3",
    "typescript": "5.9.3"
  }
}
