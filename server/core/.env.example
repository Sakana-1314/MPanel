# MPanel core 环境变量示例（server/core）
# 复制为 .env 或写入 systemd EnvironmentFile；权限建议 0600。
# 文档契约见 docs/file-layout.md §4.2；本文件同时列出新名称与兼容名称。

# ---------------------------------------------------------------------------
# 状态目录与监听
# ---------------------------------------------------------------------------
# 状态根目录：users.json / sessions.json / api-tokens.json / session.secret；
# 审计日志写入 <home>/audit.jsonl。
MPANEL_CORE_HOME=~/.mpanel-core
# 兼容 docs 中的旧名称（MPANEL_CORE_HOME 优先）
# MPANEL_HOME=~/.mpanel-core

# 监听地址，默认 127.0.0.1:8788；写 127.0.0.1:0 使用随机端口（smoke 用）
MPANEL_LISTEN=127.0.0.1:8788
# 兼容旧名称（MPANEL_LISTEN 优先）
# MPANEL_HOST=127.0.0.1
# MPANEL_PORT=8788
# MPANEL_CORE_PORT=8788

# ---------------------------------------------------------------------------
# 管理员与会话
# ---------------------------------------------------------------------------
# 首次启动（users.json 为空）时二选一：
# 1) 设置下面的种子管理员；或
# 2) 留空，core 会生成一次性 bootstrap token 打印到控制台并写入
#    <home>/state/bootstrap-token (0600)，调用 POST /api/v1/auth/setup 完成初始化。
# MPANEL_ADMIN_USER=admin
# MPANEL_ADMIN_PASSWORD=replace-with-at-least-10-chars

# 会话/API token 的 HMAC 密钥（至少 16 字符）。未设置时自动生成
# <home>/session.secret (0600)；多实例部署必须显式设置同一个值。
# MPANEL_SESSION_SECRET=

# 会话 TTL（滑动续期），默认 12h；API token 默认 TTL 同值。
MPANEL_TOKEN_TTL=12h
# 兼容旧名称，覆盖会话 TTL（小时）
# MPANEL_SESSION_TTL_HOURS=12

MPANEL_COOKIE_NAME=mpanel_session
# HTTPS 部署必须为 true；SameSite=None 时强制 Secure。
MPANEL_COOKIE_SECURE=false
MPANEL_COOKIE_SAMESITE=lax

# 允许跨域的前端来源，逗号分隔；默认空 = 仅同源。凭证模式下禁止 *。
# MPANEL_CORS_ORIGINS=https://panel.example.com
# dbx iframe 来源：加入 CSP frame-src，并额外允许其调用 handoff redeem。
# MPANEL_DBX_ORIGIN=https://dbx.example.com

# 反向代理（Caddy/nginx）后设为 true，用于读取 X-Forwarded-For/Proto
MPANEL_TRUST_PROXY=false

# ---------------------------------------------------------------------------
# 前端静态托管
# ---------------------------------------------------------------------------
# 前端 dist 目录；不存在时只提供 API。默认 <cwd>/web/dist。
# MPANEL_WEB_DIST=/opt/mpanel/web
# 兼容旧名称（MPANEL_WEB_DIST 优先）
# MPANEL_WEB_DIR=/opt/mpanel/web
# 静态 CSP 覆盖（默认已包含 frame-src dbx、nosniff、Referrer-Policy）
# MPANEL_CSP=

# ---------------------------------------------------------------------------
# 机器与传输
# ---------------------------------------------------------------------------
# 脚本用静态 Bearer token；设置后映射为 system 管理员（至少 16 字符）
# MPANEL_CORE_TOKEN=
# 公网地址，用于 reverse-ws enrollment 与同源判断
# MPANEL_PUBLIC_URL=https://panel.example.com

# stdio 机器等于在 core 主机执行命令，只在需要时显式开启
MPANEL_ALLOW_STDIO=0
# MPANEL_WORKER_ENTRY=/opt/mpanel/worker/dist/index.js

# 机器凭据 AES-256-GCM 密钥（base64 32 字节）；未设置时生成 <home>/secrets.key
# MPANEL_SECRET_KEY=
# 允许 reverse-ws 用 ?machineId=&secret= 查询参数认证（默认关闭）
MPANEL_ALLOW_WS_QUERY_SECRET=false

# handoff redeem 限流，格式 <次数>/<窗口>
MPANEL_REDEEM_RATE_LIMIT=10/60s

# 日志级别：trace|debug|info|warn|error|fatal|silent
MPANEL_LOG_LEVEL=info
