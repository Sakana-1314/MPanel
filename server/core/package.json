{
  "name": "@mpanel/core",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "MPanel core gateway (auth, machine registry, HTTP/WS proxy, static web)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mpanel-core": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.3.7",
    "@mpanel/shared": "workspace:*",
    "fastify": "^5.12.8",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.3",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
