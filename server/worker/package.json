{
  "name": "@mpanel/worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "MPanel worker agent (host capabilities exposed over HTTP + tunnel transports)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mpanel-worker": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.9",
    "@fastify/websocket": "^11.3.7",
    "@mpanel/shared": "workspace:*",
    "croner": "^11.0.1",
    "fastify": "^5.12.8",
    "ioredis": "^6.1.0",
    "pg": "^8.23.1",
    "ws": "^8.23.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.3",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
